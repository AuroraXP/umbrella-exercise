let oldPaths = new Array();

let newDo = [["start"]];

let secondSmall = false;

smallCaves.push("start")

const hasDouble = (path: string[]) =>
    path.some((cave, i) => smallCaves.includes(cave) && path.indexOf(cave) !== i);

while (newDo.length > 0) {
    const buildStack = newDo.pop()!;
    if (buildStack.length == 0){
        buildStack.push('start');  
        }

        const caveHere = buildStack[buildStack.length - 1];
        const neighbors = [];


        const usedDouble = hasDouble(buildStack);

        for (const [cave1, cave2] of parseCaves) {
            if (cave1 !== caveHere || cave2 === "start") continue;
                const alreadyVisited = smallCaves.includes(cave2) && buildStack.includes(cave2);
            if (!alreadyVisited || !usedDouble) neighbors.push(cave2);
        }

    for (const next of neighbors) {
        if (next === "end") oldPaths.push([...buildStack, "end"]);
        else newDo.push([...buildStack, next]);
    }

}


